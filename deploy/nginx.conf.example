# Example nginx reverse proxy for skein.
#
# Set in skein.toml to match:
#   [server] public_hosts = ["skein.example.com"]
#   [server] base_path    = ""      # keep empty for a dedicated host; see the note at the bottom
#
# Certificate paths are placeholders. Use your own (for example from certbot).
#
# Logs: if url_tokens is on, a token can arrive in a query string. Turn this
# server's access log off (access_log off;) or use a log format without
# $request_uri or $args. skein itself writes no access log.

server {
    listen 80;
    server_name skein.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;                        # nginx 1.25.1 or later; remove on older versions
    server_name skein.example.com;

    ssl_certificate     /etc/letsencrypt/live/skein.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skein.example.com/privkey.pem;

    # OAuth discovery (needed only when [oauth] enabled = true). The metadata
    # paths sit at the root, with base_path appended, so they are forwarded
    # even when base_path is set. Harmless when OAuth is off.
    location ~ ^/\.well-known/(oauth-authorization-server|openid-configuration|oauth-protected-resource)(/|$) {
        proxy_pass http://127.0.0.1:8771;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # skein answers with plain JSON. Buffering is off so each response passes
    # through as soon as skein sends it; long timeouts cover slow tool calls.
    location /mcp {
        proxy_pass http://127.0.0.1:8771;   # no URI part: the original path is passed unchanged
        proxy_http_version 1.1;
        proxy_set_header Host $host;        # must match an entry in public_hosts
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:8771;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# If skein runs under a path prefix (base_path = "/skein"), replace the two
# location blocks with "location /skein/mcp" and "location /skein/", and keep
# the prefix in the URL: skein serves its routes under base_path, so the
# request path must still start with /skein/. Do not add a trailing slash to
# base_path in skein.toml. Keep the OAuth discovery block above: its paths are
# at the root, outside the prefix.
